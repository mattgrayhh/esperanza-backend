# dependencies
# No trailing slash: `node_modules/` matches DIRECTORIES only, so a node_modules
# *symlink* (how git worktrees here borrow the main checkout's installs) slipped past
# it and got committed as a mode-120000 blob pointing at an absolute local path. That
# makes `npm ci` fail ENOTDIR in any fresh clone, i.e. in CI and deploy. Slashless
# matches both the real directory and the symlink.
node_modules

# build output
dist/
.next/
.open-next/

# stray tsc emit — typecheck is noEmit; these are compiled artifacts next to .ts
# sources (they also double the vitest run if collected). Never commit them.
tsconfig.tsbuildinfo
*.tsbuildinfo
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/test/**/*.js
packages/*/test/**/*.d.ts
packages/*/test/**/*.js.map
packages/*/scripts/**/*.js
packages/*/scripts/**/*.d.ts
packages/*/scripts/**/*.js.map

# wrangler / cloudflare local state
.wrangler/

# secrets — never commit real values
.dev.vars
.env
.env.*
!.dev.vars.example
!.env.example

# local D1 / sqlite scratch
*.sqlite
*.sqlite3
*.db

# logs / misc
*.log
.DS_Store
coverage/

# isolated worktrees + brainstorming companion artifacts
.claude/worktrees/
.superpowers/
backups-d1/
