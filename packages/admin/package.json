{
  "name": "@esperanza/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js 15 admin (OpenNext-on-Workers) covering all 9 entities. Auth.js v5 login. Edits D1, uploads images to R2, logs audit_log, and purges the public API cache on every write.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed-admin": "tsx scripts/seed-admin.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "gen:help": "tsx scripts/generate-help.ts",
    "predev": "npm run gen:help",
    "predeploy": "npm run gen:help"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@esperanza/community-map": "*",
    "@esperanza/db": "*",
    "@opennextjs/cloudflare": "^1.19.0",
    "@sentry/nextjs": "^10.67.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.44.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.17.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250520.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "^12.10.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "wrangler": "^4.59.0"
  }
}