# Root .dev.vars.example — copy to per-package .dev.vars (NEVER commit real values).
# These are the secret NAMES consumed across the workers. Each worker only needs
# the subset relevant to it (see README RUNBOOK "wrangler secret put" list).
# For local dev, wrangler reads .dev.vars from the package directory you run in.

# --- Snowflake (ingest) ---
SNOWFLAKE_PASSWORD=

# --- Framer push (framer-push) ---
FRAMER_API_KEY=
FRAMER_PROJECT_URL=

# --- Microsoft Graph / OneDrive renderings (renderings) ---
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# --- Airtable one-time import (ingest, import script only) ---
AIRTABLE_PAT=
