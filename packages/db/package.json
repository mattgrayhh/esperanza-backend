{
  "name": "@esperanza/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "D1 schema (Drizzle), migrations, and v_public_* views. Source of truth for the data model.",
  "main": "schema.ts",
  "types": "schema.ts",
  "exports": {
    ".": "./schema.ts",
    "./promo": "./lib/promo.ts",
    "./elevation-price": "./lib/elevation-price.ts",
    "./elevation-image": "./lib/elevation-image.ts",
    "./slug": "./lib/slug.ts",
    "./override": "./lib/override.ts",
    "./pdf-invalidate": "./lib/pdf-invalidate.ts",
    "./pdf-ensure": "./lib/pdf-ensure.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "import": "tsx scripts/import-from-airtable.ts",
    "import:dry": "tsx scripts/import-from-airtable.ts --dry-run",
    "migrate-images": "tsx scripts/migrate-images.ts",
    "migrate-images:dry": "tsx scripts/migrate-images.ts --dry-run",
    "verify": "tsx scripts/verify-import.ts",
    "scripts:typecheck": "tsc --noEmit -p scripts/tsconfig.json"
  }
}
